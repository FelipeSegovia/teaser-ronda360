---
/**
 * Botón flotante (RF-2). Aparece cuando el hero sale del viewport; el
 * observador vive en Base.astro. A 320 px se ancla abajo a la derecha con
 * margen suficiente para no tapar contenido.
 */
import { es } from '../i18n/es';
---

<button
  type="button"
  data-open-contact
  aria-haspopup="dialog"
  aria-label={es.nav.contactAria}
  class="floating-cta fixed right-4 bottom-4 z-30 flex items-center gap-2 rounded-full bg-brand px-5 py-3.5 font-semibold text-on-brand shadow-xl shadow-brand/25 transition hover:bg-brand-dark focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:outline-none sm:right-6 sm:bottom-6"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
    <path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="3" y="5" width="18" height="14" rx="2" />
  </svg>
  {es.nav.contact}
</button>
