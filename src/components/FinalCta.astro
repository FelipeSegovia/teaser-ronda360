---
import { es } from '../i18n/es';
---

<section class="border-t border-hairline bg-surface-alt">
  <div class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        {es.finalCta.title}
      </h2>
      <p class="mt-5 text-lg text-pretty text-ink-soft">{es.finalCta.body}</p>

      <button
        type="button"
        data-open-contact
        aria-haspopup="dialog"
        class="mt-8 w-full rounded-xl bg-brand px-8 py-4 text-base font-semibold text-on-brand transition hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-xl focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:outline-none sm:w-auto"
      >
        {es.finalCta.cta}
      </button>
    </div>
  </div>
</section>
