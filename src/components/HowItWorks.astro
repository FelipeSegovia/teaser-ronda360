---
import { es } from '../i18n/es';
---

<section class="container-page py-16 sm:py-24">
  <div class="max-w-2xl" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
      {es.how.title}
    </h2>
    <p class="mt-4 text-lg text-ink-soft">{es.how.subtitle}</p>
  </div>

  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {es.how.steps.map((step, i) => (
      <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
        <div class="surface-card h-full rounded-2xl border border-hairline bg-surface p-6">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand text-lg font-bold text-on-brand">
            {i + 1}
          </span>
          <h3 class="mt-5 text-xl font-semibold">{step.title}</h3>
          <p class="mt-2.5 text-ink-soft">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
