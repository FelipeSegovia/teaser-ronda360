---
import { Image } from 'astro:assets';
import { es } from '../i18n/es';
import { site } from '../config/site';
import logoLight from '../assets/ronda-control_azul.webp';
import logoDark from '../assets/ronda-control_blanco.webp';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header sticky top-0 z-40 w-full">
  <div class="container-page flex h-16 items-center justify-between gap-3 sm:gap-4">
    <a
      href="#hero"
      class="flex h-11 shrink-0 items-center overflow-hidden"
      aria-label={site.productName}
    >
      <Image
        src={logoLight}
        alt=""
        width={370}
        densities={[1, 2]}
        loading="eager"
        class="theme-light-only h-11 w-11 object-left object-cover sm:w-auto"
      />
      <Image
        src={logoDark}
        alt=""
        width={370}
        densities={[1, 2]}
        loading="eager"
        class="theme-dark-only h-11 w-11 object-left object-cover sm:w-auto"
      />
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ThemeToggle />

      <button
        type="button"
        data-open-contact
        aria-haspopup="dialog"
        aria-label={es.nav.contactAria}
        class="rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-on-brand transition hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-lg focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        {es.nav.contact}
      </button>
    </div>
  </div>
</header>
