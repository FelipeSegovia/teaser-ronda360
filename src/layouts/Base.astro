---
import '../styles/global.css';
import { es } from '../i18n/es';
import { site } from '../config/site';
import favicon from '../assets/favicon.ico';

import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import FloatingCta from '../components/FloatingCta.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!--
      Tema antes del primer pintado (spec 004, RF-2). Va aquí arriba y sin
      type="module" a propósito: un script diferido pintaría un fotograma con el
      tema equivocado. Sin valor guardado no se escribe atributo y manda
      prefers-color-scheme, que es el estado «sistema» y el defecto.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('tema');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          // localStorage lanza en modo privado de Safari: se cae a «sistema».
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={favicon} type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />

    <title>Ronda360</title>
    <meta name="description" content={es.meta.description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.productName} />
    <meta property="og:title" content={es.meta.title} />
    <meta property="og:description" content={es.meta.description} />
  </head>

  <body class="bg-surface font-sans text-ink antialiased">
    <Loader />

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-on-brand"
    >
      {es.nav.skipToContent}
    </a>

    <!-- Centinela de 1px: el header se vuelve opaco cuando este sale de vista. -->
    <div id="top-sentinel" aria-hidden="true" class="absolute top-0 h-px w-full"></div>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    <FloatingCta />
    <ContactDialog />

    <script>
      // Un solo observador para las tres cosas que dependen del scroll.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const header = document.querySelector<HTMLElement>('.site-header');
      const sentinel = document.getElementById('top-sentinel');
      const hero = document.getElementById('hero');
      const floating = document.querySelector<HTMLElement>('.floating-cta');

      if (!('IntersectionObserver' in window) || reduced) {
        // Sin observador o con movimiento reducido: todo visible de entrada.
        // La página nunca queda con contenido invisible.
        revealables.forEach((el) => el.classList.add('is-visible'));
        floating?.classList.add('is-visible');
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
        );
        revealables.forEach((el) => revealObserver.observe(el));

        if (hero && floating) {
          new IntersectionObserver(
            ([entry]) => {
              floating.classList.toggle('is-visible', !entry!.isIntersecting);
            },
            { threshold: 0 },
          ).observe(hero);
        }
      }

      if (sentinel && header) {
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            ([entry]) => header.classList.toggle('is-stuck', !entry!.isIntersecting),
            { threshold: 0 },
          ).observe(sentinel);
        } else {
          header.classList.add('is-stuck');
        }
      }
    </script>
  </body>
</html>
